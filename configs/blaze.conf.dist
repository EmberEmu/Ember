# Blaze configuration

[plugins]
enable = 1
path = @CMAKE_INSTALL_PREFIX@/plugins/

[misc]
threads = 0 # leave as 0 to automatically determine

[remote_log]
service_name = blaze
verbosity = none # trace, debug, info, warning, error, fatal or none to disable
host = localhost
port = 514

[file_log]
verbosity = none  # trace, debug, info, warning, error, fatal or none to disable
path = @CMAKE_INSTALL_PREFIX@/logs/blaze_%d_%m_%Y.log
midnight_rotate = 0
mode = append     # if an existing log is found, you can either 'append' to it or 'truncate' it
size_rotate = 0   # max log size in megabytes - 0 disables
timestamp = 0 # enable/disable timestamping log records
timestamp_format = [%d/%m/%Y %H:%M:%S] 
severity = 1  # enable/disable writing severity to log records

[console_log]
enable_input = true # allows for commands to be executed on the console
suggestions = true  # enables tab completion suggestions (only applicable when input enabled)
verbosity = trace   # trace, debug, info, warning, error, fatal or none to disable
colours = true      # colourise the output
filter_mask = 0
theme = abyssal     # legacy, aurora, aurora_day, abyssal, smoky, sahara, regalia, midnight (requires true colour terminal support)
no_bg = false       # disables theme bg colours, uses terminal default
win_ansi = true     # Windows: use ANSI output rather than WinAPI (falls back if unsupported)
timestamp = on # enable/disable timestamping log records
timestamp_format = %d/%m/%Y %H:%M:%S