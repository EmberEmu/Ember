# Fusion configuration

# Specify which services should be run within the Fusion instance
[mdns]
active = true
config = @CMAKE_INSTALL_PREFIX@/mdns.conf
prefix = [mdns]
file = @CMAKE_INSTALL_PREFIX@/logs/mdns_fusion_%d_%m_%Y.log

[account]
active = true
config = @CMAKE_INSTALL_PREFIX@/account.conf
prefix = [account]
file = @CMAKE_INSTALL_PREFIX@/logs/fusion_account_%d_%m_%Y.log

[character]
active = true
config = @CMAKE_INSTALL_PREFIX@/character.conf
prefix = [character]
file = @CMAKE_INSTALL_PREFIX@/logs/fusion_character_%d_%m_%Y.log

[login]
active = true
config = @CMAKE_INSTALL_PREFIX@/login.conf
prefix = [login]
file = @CMAKE_INSTALL_PREFIX@/logs/fusion_login_%d_%m_%Y.log

[realm]
active = true
config = @CMAKE_INSTALL_PREFIX@/realm.conf
prefix = [realm]
file = @CMAKE_INSTALL_PREFIX@/logs/fusion_realm_%d_%m_%Y.log

[world]
active = true
config = @CMAKE_INSTALL_PREFIX@/world.conf
prefix = [world]
file = @CMAKE_INSTALL_PREFIX@/logs/fusion_world_%d_%m_%Y.log

[remote_log]
service_name = fusion
verbosity = none # trace, debug, info, warning, error, fatal or none to disable
host = localhost
port = 514
filter-mask = 0

[file_log]
verbosity = none  # trace, debug, info, warning, error, fatal or none to disable
path = @CMAKE_INSTALL_PREFIX@/logs/fusion_%d_%m_%Y.log
midnight_rotate = 0
mode = append     # if an existing log is found, you can either 'append' to it or 'truncate' it
size_rotate = 0   # max log size in megabytes - 0 disables
log_timestamp = 0 # enable/disable timestamping log records
timestamp_format = [%d/%m/%Y %H:%M:%S] 
log_severity = 1  # enable/disable writing severity to log records
filter-mask = 0

[console_log]
enable_input = true # allows for commands to be executed on the console but is incompatible with prefixes
suggestions = true  # enables tab completion suggestions (only applicable when input enabled)
verbosity = trace   # trace, debug, info, warning, error, fatal or none to disable
colours = true      # colourise the output
filter-mask = 0
prefix = [fusion]
win32_ansi = false  # use cross-platform input sink rather than Win32 API sink (Windows only)