namespace ember.rpc.Account;

enum DisconnectReason : ubyte {
	internal_error,
	account_suspended,
	account_banned,
	player_kicked
}

enum Status : ubyte {
	unknown_status,
	ok,
	rpc_error,
	illformed_message,
	already_logged_in,
	session_not_found,
	account_not_found,
	unknown_error
}

table LookupID {
	account_name:string;
}

table AccountFetchResponse {
	status:Status;
	account_id:uint;
}

table RegisterSession {
	account_id:uint;
	key:[ubyte];
}

table SessionLookup {
	account_id:uint;
}

table SessionResponse {
	status:Status;
	account_id:uint;
	key:[ubyte];	
}

table DisconnectID {
	account_id:uint;
	reason:DisconnectReason;
}

table DisconnectSession {
	key:[ubyte];
	reason:DisconnectReason;
}

table RegisterResponse {
	status:Status;
}

table DisconnectResponse {
	status:Status;
}

table DisconnectSessionResponse {
	status:Status;
}

union Message {
	SessionLookup,
	RegisterSession,
	LookupID,
	DisconnectSession,
	DisconnectID,
	SessionResponse,
	RegisterResponse,
	AccountFetchResponse,
	DisconnectResponse,
	DisconnectSessionResponse
}

table Envelope {
	message: Message;
}

root_type Envelope;

rpc_service Account {
	session_fetch(SessionLookup):SessionResponse;
	register_session(RegisterSession):RegisterResponse;
	account_id_fetch(LookupID):AccountFetchResponse;
	disconnect_by_session(DisconnectSession):DisconnectSessionResponse;
	disconnect_by_id(DisconnectID):DisconnectResponse;
}