// Absolute minimum required to get RealmList to compile under libc++ until properly supported

#pragma once

#ifndef __cpp_lib_atomic_shared_ptr

#include <atomic>
#include <memory>
#include <mutex>

namespace std:: inline __1 {

template<typename T>
class atomic<shared_ptr<T>> {
    std::shared_ptr<T> _ptr;
    mutable std::mutex _mutex;

public:
    atomic(std::shared_ptr<T> val) : _ptr(val) { }

    atomic() : _ptr(make_shared<T>()) { }
    
    auto load() const {
        std::lock_guard lock(_mutex);
        return _ptr;
    }

    void operator=(std::shared_ptr<T> ptr) {
        std::lock_guard lock(_mutex);
        _ptr = ptr;
    }
};

}

#endif