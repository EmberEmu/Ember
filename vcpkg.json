{
  "dependencies": [
    "boost-assert",
    "boost-asio",
    "boost-headers",
    "boost-interprocess",
    "boost-locale",
    "boost-program-options",
    "boost-system",
    "boost-uuid",
    "botan",
    "flatbuffers",
    "pcre",
    "zlib",
    "angelscript",
    "jsoncons",
    "mysql-connector-cpp"
  ],
  "features": {
    "mimalloc": {
      "description": "Use mimalloc memory allocator",
      "dependencies": [
        {
          "name": "mimalloc",
          "features": [
            "override"
          ]
        }
      ]
    },
    "jemalloc": {
      "description": "Use jemalloc memory allocator",
      "dependencies": [
        "jemalloc"
      ]
    }
  },
  "overrides": [
    {
      "name": "mysql-connector-cpp",
      "version": "1.1.13"
    }
  ]
}